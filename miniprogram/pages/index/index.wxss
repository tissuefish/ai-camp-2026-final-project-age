/* pages/index/index.wxss */
.container {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  padding: 32rpx;
  box-sizing: border-box;
}

.card {
  width: 100%;
  background: #ffffff;
  border-radius: 32rpx;
  box-shadow: 0 10rpx 40rpx rgba(30, 41, 59, 0.12);
  padding: 40rpx;
  text-align: center;
}

.title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1e293b;
}

.sub {
  font-size: 26rpx;
  color: #64748b;
  margin: 8rpx 0 30rpx;
}

.preview {
  width: 360rpx;
  height: 360rpx;
  margin: 0 auto 30rpx;
  border-radius: 50%;
  background: #e2e8f0;
  border: 4rpx dashed #cbd5e1;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.preview-img {
  width: 100%;
  height: 100%;
}

.placeholder {
  color: #94a3b8;
  font-size: 26rpx;
}

.btn {
  margin-top: 20rpx;
  border-radius: 20rpx;
  font-size: 30rpx;
}

.btn.primary {
  background: #4f46e5;
  color: #ffffff;
}

.btn[disabled] {
  background: #cbd5e1;
  color: #94a3b8;
}

.error {
  margin-top: 20rpx;
  color: #dc2626;
  font-size: 26rpx;
}

.result {
  margin-top: 28rpx;
  padding: 30rpx;
  border-radius: 24rpx;
  background: #f1f5f9;
}

.result .label {
  font-size: 26rpx;
  color: #64748b;
}

.result .age {
  font-size: 88rpx;
  font-weight: 700;
  color: #4f46e5;
}

.result .note {
  font-size: 22rpx;
  color: #94a3b8;
  margin-top: 10rpx;
}

.footer {
  margin-top: 30rpx;
  font-size: 22rpx;
  color: #94a3b8;
}
